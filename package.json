{
  "name": "chainhive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:render": "chmod +x build-render.sh && ./build-render.sh",
    "postinstall": "npm ls @noditlabs/nodit-mcp-server || npm install @noditlabs/nodit-mcp-server@latest",
    "start": "node api/server.js",
    "start:prod": "NODE_ENV=production node api/server.js",
    "start:dev": "nodemon api/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "preview": "vite preview",
    "test:multichain": "node test-multichain.js",
    "test:multichain:windows": "powershell -ExecutionPolicy Bypass -File test-multichain.ps1",
    "test:api": "node test-api-endpoints.js",
    "test:api:local": "node test-api-endpoints.js http://localhost:3000",
    "test:api:vercel": "node test-api-endpoints.js https://your-vercel-url.vercel.app",
    "test:api:render": "node test-api-endpoints.js https://your-render-url.onrender.com",
    "test:all": "npm run lint && npm run test:multichain && npm run test:api:local && npm run build",
    "test:server": "node test-server.js",
    "server": "nodemon server.js",
    "bot": "node bot-server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "serve": "http-server . -p 8080 -c-1",
    "docs:generate": "swagger-jsdoc -d docs/swagger.config.js -o docs/api-spec.yaml",
    "docs:serve": "swagger-ui-serve docs/api-spec.yaml",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "precommit": "npm run lint && npm run test:unit",
    "deploy:render": "git push origin main",
    "health:check": "node healthcheck.js",
    "verify:deployment": "node verify-render-deployment.js",
    "debug:render": "node verify-render-deployment.js"
  },
